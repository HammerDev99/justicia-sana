---
export interface Props {
  readonly mensaje: string;
}

const { mensaje } = Astro.props;
---

<div class="rounded-lg border border-dashed border-brand-surface-alt p-8 text-center">
  <p class="font-semibold text-brand-primary">Sección en preparación</p>
  <p class="mt-2 text-sm text-brand-ink">{mensaje}</p>
</div>
