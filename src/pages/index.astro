---
import PageLayout from '../layouts/PageLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Card from '../components/ui/Card.astro';
import Callout from '../components/ui/Callout.astro';
import Accordion from '../components/ui/Accordion.astro';
import type { AccordionItem } from '../components/ui/Accordion.astro';
import AyudaBanner from '../components/ui/AyudaBanner.astro';
import { fetchCanalesAyuda } from '../lib/strapi';

/**
 * Cableado real contra Strapi (F3-05). Sin instancia en producción hoy,
 * degrada a [] y AyudaBanner cae a su fallback ya auditado en F2 (enlace a
 * /canales-de-ayuda, sin fabricar contacto).
 */
const canales = await fetchCanalesAyuda();
const canalAyudaPsicologica = canales.find((canal) => canal.tipo_canal === 'Atención psicológica');

const faq: readonly AccordionItem[] = [
  {
    question: '¿Qué es el Comité de Convivencia Laboral?',
    answer:
      'Es la instancia de la Rama Judicial encargada de la gestión preventiva, confidencial y pedagógica frente al acoso laboral, alineada con la Resolución 3461 de 2025 del Ministerio de Trabajo.',
  },
  {
    question: '¿Puedo radicar una queja desde este portal?',
    answer:
      'No. Este sitio es un prototipo informativo y no recibe quejas. Las quejas formales de acoso laboral se presentan por los canales oficiales de la Rama Judicial.',
  },
];
---

<PageLayout title="Inicio">
  <PageHeader
    title="Convivencia laboral en la Rama Judicial — prototipo para la Seccional Magdalena"
    description="Propuesta en evaluación de un portal informativo con normativa, material pedagógico y orientación sobre la prevención del acoso laboral, en armonía con la Resolución 3461 de 2025."
  />

  <div class="mt-6 max-w-2xl">
    <Callout variant="info" title="¿Buscas radicar una queja?">
      Este sitio es un prototipo informativo y no recibe quejas. Las quejas formales de acoso
      laboral se presentan por los canales oficiales de la Rama Judicial.
    </Callout>
  </div>

  <section class="mt-10 grid gap-6 sm:grid-cols-3" aria-label="Accesos rápidos">
    <Card
      href="/canales-de-ayuda"
      title="Ayuda psicológica"
      description="Canales de atención y contacto del Comité."
    />
    <Card
      href="/normativa"
      title="Normativa"
      description="Ley 1010/2006, Resolución 3461/2025 y más."
    />
    <Card
      href="/quienes-somos"
      title="¿Quiénes somos?"
      description="Objetivo, conformación y marco legal del Comité."
    />
  </section>

  <section class="mt-10 max-w-2xl">
    <h2 class="text-xl font-semibold text-brand-primary">Preguntas frecuentes</h2>
    <div class="mt-4">
      <Accordion items={faq} />
    </div>
  </section>

  <div class="mt-10 max-w-2xl">
    <AyudaBanner
      telefono={canalAyudaPsicologica?.telefono ?? undefined}
      correo={canalAyudaPsicologica?.correo ?? undefined}
    />
  </div>
</PageLayout>
