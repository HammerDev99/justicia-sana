---
import PageLayout from '../layouts/PageLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import ComingSoon from '../components/ui/ComingSoon.astro';
import { fetchCapacitaciones, fetchComunicados } from '../lib/strapi';

/**
 * Cableado real contra Strapi (F3-06). Sin instancia en producción hoy,
 * ambas colecciones degradan a [] y se muestra un placeholder honesto.
 * `Comunicado.cuerpo` (richtext) se divide en párrafos de texto plano, sin
 * `set:html` — mismo criterio de seguridad que /noticias/[slug].
 */
const capacitaciones = await fetchCapacitaciones();
const comunicados = await fetchComunicados();
const sinContenido = capacitaciones.length === 0 && comunicados.length === 0;
---

<PageLayout
  title="Capacitaciones y comunicados"
  description="Calendario de capacitaciones y boletines informativos del Comité de Convivencia Laboral."
>
  <PageHeader
    title="Capacitaciones y comunicados"
    description="Calendario informativo de capacitaciones y boletines del Comité de Convivencia Laboral."
  />

  {
    sinContenido ? (
      <div class="mt-8 max-w-2xl">
        <ComingSoon mensaje="El Comité aún no ha publicado capacitaciones ni comunicados. Se publicarán en esta sección tan pronto estén disponibles." />
      </div>
    ) : (
      <>
        {capacitaciones.length > 0 && (
          <section class="mt-8" aria-label="Capacitaciones">
            <h2 class="text-xl font-semibold text-brand-primary">Capacitaciones</h2>
            <ul class="mt-4 space-y-4" role="list">
              {capacitaciones.map((capacitacion) => (
                <li class="rounded-lg border border-brand-surface-alt p-4">
                  <p class="font-semibold text-brand-primary">{capacitacion.titulo}</p>
                  <p class="mt-1 text-sm">{capacitacion.descripcion}</p>
                  <p class="mt-1 text-xs text-brand-ink">
                    {capacitacion.fecha} · {capacitacion.modalidad}
                  </p>
                  {capacitacion.enlace_inscripcion && (
                    <a
                      href={capacitacion.enlace_inscripcion}
                      class="mt-2 inline-block text-sm underline"
                    >
                      Inscripción
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}

        {comunicados.length > 0 && (
          <section class="mt-10" aria-label="Comunicados">
            <h2 class="text-xl font-semibold text-brand-primary">Comunicados</h2>
            <ul class="mt-4 space-y-4" role="list">
              {comunicados.map((comunicado) => (
                <li class="rounded-lg border border-brand-surface-alt p-4">
                  <p class="font-semibold text-brand-primary">{comunicado.titulo}</p>
                  <p class="mt-1 text-xs text-brand-ink">{comunicado.fecha}</p>
                  {comunicado.cuerpo.split(/\n{2,}/).map((parrafo) => (
                    <p class="mt-2 text-sm">{parrafo}</p>
                  ))}
                </li>
              ))}
            </ul>
          </section>
        )}
      </>
    )
  }
</PageLayout>
