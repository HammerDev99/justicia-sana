---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { fetchArticulos } from '../../lib/strapi';
import type { Articulo } from '../../lib/types';

interface ArticuloPath {
  readonly params: { readonly slug: string };
  readonly props: { readonly articulo: Articulo };
}

/**
 * Cableado real contra Strapi (F3-04). Sin instancia en producción hoy,
 * fetchArticulos() devuelve [] y esta ruta dinámica genera 0 páginas de
 * detalle — comportamiento correcto y esperado (no hay artículos que mostrar).
 */
export async function getStaticPaths(): Promise<readonly ArticuloPath[]> {
  const articulos = await fetchArticulos();
  return articulos.map((articulo) => ({
    params: { slug: articulo.slug },
    props: { articulo },
  }));
}

export interface Props {
  readonly articulo: Articulo;
}

const { articulo } = Astro.props;

/**
 * `cuerpo` viene de un campo `richtext` de Strapi. Deliberadamente NO se
 * renderiza con `set:html` — se divide en párrafos de texto plano, que Astro
 * escapa automáticamente. Mitiga XSS almacenado si una cuenta editora es
 * comprometida o publica contenido malicioso; se pierde formato enriquecido
 * a cambio (decisión documentada en SPEC_S04_F3_CONTENIDO.md).
 */
const parrafos = articulo.cuerpo.split(/\n{2,}/);
---

<PageLayout title={articulo.titulo} description={articulo.resumen}>
  <PageHeader title={articulo.titulo} description={articulo.resumen} />
  <p class="mt-2 text-xs font-semibold uppercase text-brand-accent">
    {articulo.categoria} · {articulo.fecha_publicacion}
  </p>

  <div class="mt-6 max-w-2xl">
    {parrafos.map((parrafo) => <p class="mt-4">{parrafo}</p>)}
  </div>

  <p class="mt-8">
    <a href="/noticias" class="text-brand-primary underline"> Volver a noticias </a>
  </p>
</PageLayout>
